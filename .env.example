# Environment for the guideline server (compose.yaml). Copy this file to .env; never commit .env.
# Deploy tools that run compose.yaml from Git (Komodo and the like) take the same keys in their environment settings.

# Required (secret). At least 32 characters. Create one with: openssl rand -base64 48
ADMIN_TOKEN=
# Required. The address users open in the browser
PUBLIC_URL=https://guideline.example.com
# Required. Host path for the DB and backups. Must be writable by uid 1000 (chown 1000:1000)
DATA_HOST_DIR=/data/guideline
# Optional (3000). Port opened on the host
HOST_PORT=3000
# Optional (14). Number of automatic backups to keep
BACKUP_KEEP=14
# Optional (0). 1 behind a reverse proxy
TRUST_PROXY=0
# Optional (1). 1 lets anyone view guidelines (web, read API, CLI pick/update) without login or token. 0 requires an admin login or read token
PUBLIC_READ=1
# Optional (en). Language of the admin web and of an empty server's seed. ko for Korean. User language packs go in DATA_HOST_DIR/locales/<code>/
GUIDELINE_LANG=en
# Optional (on). off skips the seed (authoring rules, seed skills) of an empty server
GUIDELINE_SEED=on
